# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

NODE_ENV=development
PORT=3000

# --- Database ---
DB_USER=droos
DB_PASSWORD=change_me_locally
DB_NAME=droos_hub
DB_PORT=5432

# Inside docker compose, the host is the service name "db".
# If you run the API on your machine against the dockerised Postgres,
# change @db: to @localhost:
DATABASE_URL=postgresql://droos:change_me_locally@db:5432/droos_hub

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
